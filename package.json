{
  "name": "job-search-aggregator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "IT remote job aggregator for GitHub Pages",
  "scripts": {
    "extract": "node scripts/extract-bookmarks.mjs && node scripts/extract-empresas.mjs",
    "extract:empresas": "node scripts/extract-empresas.mjs",
    "fetch-ats": "node scripts/fetch-ats.mjs",
    "fetch-apinfo": "node scripts/fetch-apinfo.mjs",
    "fetch-live": "node scripts/fetch-live-apis.mjs",
    "fetch-rss": "node scripts/fetch-rss.mjs",
    "fetch-jobs": "node scripts/fetch-ats.mjs && node scripts/fetch-apinfo.mjs && node scripts/fetch-live-apis.mjs && node scripts/fetch-rss.mjs",
    "probe-ats": "node scripts/probe-ats.mjs",
    "health": "node scripts/health-check-sources.mjs",
    "health:full": "node scripts/health-check-sources.mjs --deeplinks",
    "validate-search": "node scripts/validate-search.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:live": "node scripts/run-live-tests.mjs",
    "serve": "npx --yes serve -l 4173 ."
  },
  "engines": {
    "node": ">=18"
  }
}
